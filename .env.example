# Database
DATABASE_URL="postgres://tesajor:tesajor@localhost:5433/tesajor"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 33"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Telegram (see README for @BotFather setup steps). Leave TELEGRAM_BOT_TOKEN
# unset to disable Telegram sign-in/payment requests entirely.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="generate-with: openssl rand -hex 32"

# Google Maps (optional — needs a GCP project with billing enabled).
# Leave unset and the trip-agenda map falls back to a plain stop list;
# "navigate to next stop" and live-position nearest-stop work regardless,
# since those need no API key at all.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# OpenRouteService (optional — road routes between trip stops; free key at
# https://openrouteservice.org/, ~2 000 requests/day). Leave unset and the
# day map keeps straight lines between stops; Follow mode still works with
# straight-line distances (no ETA). Routes are cached in route_cache, so
# the quota is only spent when a leg changes.
OPENROUTESERVICE_API_KEY=""

# Text-to-speech (optional — pre-generated Khmer/English voice clips for
# trip arrival welcomes and reminders). TTS_PROVIDER is "azure" or
# "google"; Azure also needs TTS_REGION (e.g. "southeastasia"). Leave
# unset and the voice companion degrades to on-device speech if a Khmer
# voice exists, else a chime + banner. Clips are cached by phrase text, so
# usage stays far inside both providers' free tiers.
TTS_PROVIDER=""
TTS_API_KEY=""
TTS_REGION=""

# Cron secret (needed only for Telegram voice reminders in production —
# Vercel cron sends it as "Authorization: Bearer <secret>" to
# /api/cron/voice-reminders; the route 401s without a match). Unset →
# reminders are in-app only.
CRON_SECRET="generate-with: openssl rand -hex 32"

# Cloudinary (optional — file uploads: avatars, receipts, payment QR
# codes). Leave unset and uploads are written to ./public/uploads on the
# local disk instead. All three must be set together to enable it.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
